APP_NAME="The Bank of Azad Jammu & Kashmir"
APP_ENV=local
APP_KEY=
# MUST be false in production (true leaks stack traces and secrets)
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# production: error
LOG_LEVEL=debug

# Production database is MariaDB 11.x. Use sqlite/mysql locally if you prefer.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# production (HTTPS): true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail: contact-form notifications are sent through this mailer.
# Local: mailpit. Production: your real SMTP provider.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@bankajk.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Contact details (read through config/bank.php)
BANK_BRANCHES_COUNT=87
BANK_ESTABLISHED_YEAR=2006
BANK_SERVING_DISTRICTS="All Districts of AJK"
CONTACT_PHONE="+92.5822.924244"
CONTACT_EMAIL=info@bankajk.com
CONTACT_ADDRESS="Head Office, Bank Square, Chattar Domel, Muzaffarabad, AJK, Pakistan"
COMPANY_SECRETARY_PHONE="+92-5822-920002"
HRMD_PHONE="+92-5822-923138"
# Optional: separate inbox for contact-form notifications (defaults to CONTACT_EMAIL)
CONTACT_FORM_RECIPIENT=

# Social links
SOCIAL_FACEBOOK_URL=#
SOCIAL_TWITTER_URL=#
SOCIAL_INSTAGRAM_URL=#
SOCIAL_LINKEDIN_URL=#
SOCIAL_YOUTUBE_URL=#

# Footer: banking links
PORTAL_LOGIN_URL=
BRANCH_LOCATOR_URL=https://bankajk.com/branch-locator
ATM_LOCATOR_URL=https://bankajk.com/atm-locator
EXCHANGE_RATES_URL=https://bankajk.com/exchange-rates
INTEREST_RATES_URL=https://bankajk.com/interest-rates
FORMS_URL=https://bankajk.com/forms-applications
TENDERS_URL=https://bankajk.com/tenders-notices

# Footer: regulatory links (the short names SBP, SECP, ... are accepted too)
PRIVACY_POLICY_URL=https://bankajk.com/privacy-policy
TERMS_URL=https://bankajk.com/terms-conditions
COOKIE_POLICY_URL=https://bankajk.com/cookie-policy
ACCESSIBILITY_URL=https://bankajk.com/accessibility
REGULATORY_INFO_URL=https://bankajk.com/regulatory-information
SECURITY_TIPS_URL=https://bankajk.com/security-tips
FRAUD_PREVENTION_URL=https://bankajk.com/fraud-prevention
SBP_URL=https://www.sbp.org.pk
BANKING_MOHTASIB_URL=https://www.bankingmohtasib.gov.pk
SECP_URL=https://www.secp.gov.pk
GOAJK_URL=https://www.ajk.gov.pk
GOPAK_URL=https://www.pakistan.gov.pk
AJK_TOURISM_URL=https://tourism.ajk.gov.pk
LOAN_CALCULATOR_URL=https://bankajk.com/loan-calculator

# Loan rates (%)
LOAN_RATE_PERSONAL=14.0
LOAN_RATE_SALARY=15.0
LOAN_RATE_CAR=12.5
LOAN_RATE_MOTORCYCLE=13.5
LOAN_RATE_HOUSE=11.5
LOAN_RATE_STUDENT=10.0
LOAN_RATE_GOLD=12.0
LOAN_RATE_HOME_APPLIANCES=13.0
LOAN_RATE_PENSION=13.0
LOAN_RATE_BUSINESS=13.5
LOAN_RATE_AGRICULTURE=11.0

# Deposit rates (%)
DEPOSIT_RATE_SAVINGS=7.0
DEPOSIT_RATE_CURRENT=0.0
DEPOSIT_RATE_TERM_1YEAR=8.5
DEPOSIT_RATE_TERM_2YEAR=9.0
DEPOSIT_RATE_TERM_3YEAR=9.5
DEPOSIT_RATE_TERM_5YEAR=10.0
DEPOSIT_RATE_SPECIAL_SAVINGS=8.0

# Loan calculator limits
LOAN_MIN_ADVANCE_SALARY=10000
LOAN_MAX_ADVANCE_SALARY=3000000
LOAN_TENURE_MIN_ADVANCE_SALARY=1
LOAN_TENURE_MAX_ADVANCE_SALARY=48
LOAN_MIN_CAR=100000
LOAN_MAX_CAR=3000000
LOAN_TENURE_MIN_CAR=12
LOAN_TENURE_MAX_CAR=60
LOAN_MIN_MOTORCYCLE=50000
LOAN_MAX_MOTORCYCLE=500000
LOAN_TENURE_MIN_MOTORCYCLE=12
LOAN_TENURE_MAX_MOTORCYCLE=36
LOAN_MIN_HOUSE=500000
LOAN_MAX_HOUSE=10000000
LOAN_TENURE_MIN_HOUSE=12
LOAN_TENURE_MAX_HOUSE=240
LOAN_MIN_PERSONAL=50000
LOAN_MAX_PERSONAL=1000000
LOAN_TENURE_MIN_PERSONAL=6
LOAN_TENURE_MAX_PERSONAL=36
LOAN_MIN_STUDENT=100000
LOAN_MAX_STUDENT=10000000
LOAN_TENURE_MIN_STUDENT=6
LOAN_TENURE_MAX_STUDENT=24
LOAN_MIN_GOLD=25000
LOAN_MAX_GOLD=2000000
LOAN_TENURE_MIN_GOLD=6
LOAN_TENURE_MAX_GOLD=24
LOAN_MIN_HOME_APPLIANCES=25000
LOAN_MAX_HOME_APPLIANCES=200000
LOAN_TENURE_MIN_HOME_APPLIANCES=6
LOAN_TENURE_MAX_HOME_APPLIANCES=36
LOAN_MIN_PENSION=10000
LOAN_MAX_PENSION=500000
LOAN_TENURE_MIN_PENSION=6
LOAN_TENURE_MAX_PENSION=24
LOAN_MIN_RUNNING_FINANCE=100000
LOAN_MAX_RUNNING_FINANCE=5000000
LOAN_MIN_AUTO_FINANCE=200000
LOAN_MAX_AUTO_FINANCE=5000000
LOAN_MIN_DEMAND_FINANCE=100000
LOAN_MAX_DEMAND_FINANCE=10000000
LOAN_MIN_CONSTRUCTION_FINANCE=500000
LOAN_MAX_CONSTRUCTION_FINANCE=20000000
LOAN_MIN_TOURISM_FINANCE=100000
LOAN_MAX_TOURISM_FINANCE=5000000
LOAN_MIN_SMALL_BUSINESS=50000
LOAN_MAX_SMALL_BUSINESS=500000
LOAN_MIN_HEALTHCARE=100000
LOAN_MAX_HEALTHCARE=10000000
LOAN_MIN_AGRICULTURE_PRODUCTION=10000
LOAN_MAX_AGRICULTURE_PRODUCTION=200000
LOAN_TENURE_MIN_AGRICULTURE_PRODUCTION=3
LOAN_TENURE_MAX_AGRICULTURE_PRODUCTION=12
LOAN_MIN_AGRICULTURE_DEVELOPMENT=50000
LOAN_MAX_AGRICULTURE_DEVELOPMENT=1000000
LOAN_TENURE_MIN_AGRICULTURE_DEVELOPMENT=12
LOAN_TENURE_MAX_AGRICULTURE_DEVELOPMENT=60
LOAN_MIN_MICRO_ENTERPRISE=10000
LOAN_MAX_MICRO_ENTERPRISE=100000
LOAN_TENURE_MIN_MICRO_ENTERPRISE=6
LOAN_TENURE_MAX_MICRO_ENTERPRISE=36
LOAN_MIN_POULTRY=15000
LOAN_MAX_POULTRY=50000

# Security (see docs). Set TRUSTED_PROXIES behind Cloudflare/nginx/cPanel proxy so rate limits use the real visitor IP.
# Use "*" to trust every proxy, or a comma separated list of proxy IPs.
TRUSTED_PROXIES=
FORCE_HTTPS=false
CSP_ENABLED=true
# Requests per minute per IP
WEB_RATE_LIMIT=600
API_RATE_LIMIT=60
DOWNLOAD_RATE_LIMIT=30
# Contact form submissions per IP per 10 minutes
CONTACT_RATE_LIMIT=5

# Large file uploads (financial statements, downloads ...). Files are sent in chunks, so PHP's
# upload_max_filesize/post_max_size do not limit them; only the web server body limit must be >= chunk size.
UPLOAD_CHUNK_BYTES=4194304
# Anyone with the module permission (financial reports, annual reports, highlights, downloads) may upload up to 10 GB;
# schedules of charges and vacancy documents up to 500 MB. A super-admin may always upload up to UPLOAD_MAX_BYTES.
UPLOAD_LARGE_MAX_BYTES=10737418240
UPLOAD_DOCUMENT_MAX_BYTES=524288000
UPLOAD_MAX_BYTES=10737418240
UPLOAD_MAX_ACTIVE=3
UPLOAD_STALE_HOURS=24
UPLOAD_RESERVE_BYTES=1073741824
